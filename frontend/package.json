{
  "name": "ipo-forensic-analysis-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": "^22.22.0 || >=23.0.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:types": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/generated/schema.d.ts"
  },
  "dependencies": {
    "motion": "^14.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "globals": "^16.5.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
